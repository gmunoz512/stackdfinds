# Copy to .env for local dev. Vite inlines these at build time.
# GitHub Pages injects the same names from repository variables.
# VITE_SUPABASE_PUBLISHABLE_KEY is the Supabase anon key. It is public in the
# browser bundle. Never put a service-role key, Stripe secret, or password here.

VITE_SUPABASE_URL=https://ilityngsjxknvxtqrgav.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://localhost:8080

# Stackd project (booking requests, vendor payout details, host pages).
# Public anon key. Never put the service-role key here.
VITE_STACKD_SUPABASE_URL=https://lryeshzwwhcdtzemeyzk.supabase.co
VITE_STACKD_SUPABASE_ANON_KEY=
